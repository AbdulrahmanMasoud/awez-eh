APP_NAME="Awez Eh"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8020

# Host ports of the Sail stack. They differ from SellBubble's (8000, 5442, 6389) so both run at once.
APP_PORT=8020
FORWARD_DB_PORT=5452
FORWARD_REDIS_PORT=6399

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=awez_eh
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Photos and documents: the local disks until R2 exists (step 4.4). For R2, set MEDIA_DISK=r2,
# MEDIA_PRIVATE_DISK=r2_private and the R2_* values (keys only in .env, never committed).
MEDIA_DISK=public
MEDIA_PRIVATE_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=

VITE_APP_NAME="${APP_NAME}"

# Sign-in (ADR 0003): comma-separated client ids. Google: the Android, iOS and web clients; Apple: the bundle id.
AWEZ_GOOGLE_CLIENT_IDS=
AWEZ_APPLE_CLIENT_IDS=
# `fake:<email>` as an ID token, for local real runs only (refused at boot elsewhere).
AWEZ_SIGN_IN_FAKE=false
# `log` (local and testing only) or, from step 4.3b, `whatsapp_inbound`.
AWEZ_PHONE_VERIFICATION_DRIVER=log

# Real estate (task 008): asking owners' numbers per account per hour; the platform account that
# owns brokered properties of owners without an account (`awez:platform-account`); demo photos in
# local seeding (drawn, then cleaned and converted like real ones).
AWEZ_CONTACT_RATE_LIMIT_PER_HOUR=30
AWEZ_PLATFORM_ACCOUNT_EMAIL=platform@awezeh.com
AWEZ_DEMO_PHOTOS=true
