includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: max

    # Read the casts() arrays, so attributes have their cast types (enums, Money, Point, dates).
    parseModelCastsMethod: true
